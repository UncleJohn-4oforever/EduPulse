# Copy to .env for customization. No default administrator password.
# Default data directory: %USERPROFILE%\EduPulseData (Windows) or ~/EduPulseData
# EDUPULSE_DATA_DIR=D:\EduPulseData
EDUPULSE_HOST=0.0.0.0
EDUPULSE_PORT=8000
# For trusted HTTPS deployment set true and provide certificate/key paths.
EDUPULSE_SECURE_COOKIE=false
# EDUPULSE_SSL_CERT=D:\certificates\campus.crt
# EDUPULSE_SSL_KEY=D:\certificates\campus.key
# Windows uses Microsoft YaHei. Linux requires a CJK font:
# EDUPULSE_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
